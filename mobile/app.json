{
  "expo": {
    "name": "MedGuard",
    "slug": "medguard",
    "scheme": "medguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F8FB",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.medguard.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "MedGuard uses the camera to read medication labels. Photos are processed to extract the label text and are not stored.",
        "NSPhotoLibraryUsageDescription": "MedGuard can read a medication label from a photo you choose.",
        "NSFaceIDUsageDescription": "MedGuard can use Face ID to unlock your medication information.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.medguard.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA", "android.permission.USE_BIOMETRIC", "android.permission.VIBRATE"]
    },
    "platforms": ["ios", "android"],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F8FB",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MedGuard uses the camera to read medication labels."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MedGuard can read a medication label from a photo you choose."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MedGuard can use Face ID to unlock your medication information."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2F6FED"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:5175"
    }
  }
}
