{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=medguard;Username=medguard;Password=medguard",
    "Redis": ""
  },
  "Database": {
    "AutoMigrate": true
  },
  "Jwt": {
    "Issuer": "medguard",
    "Audience": "medguard-app",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Security": {
    "FieldEncryptionKey": ""
  },
  "DrugData": {
    "Providers": [ "local", "rxnorm", "openfda" ],
    "RxNormBaseUrl": "https://rxnav.nlm.nih.gov/REST/",
    "OpenFdaBaseUrl": "https://api.fda.gov/",
    "OpenFdaApiKey": "",
    "TimeoutSeconds": 8,
    "InteractionProvider": ""
  },
  "Ai": {
    "ExplanationsEnabled": false,
    "VisionEnabled": false,
    "BaseUrl": "https://api.openai.com/v1/",
    "ApiKey": "",
    "ExplanationModel": "gpt-4o-mini",
    "VisionModel": "gpt-4o-mini",
    "TimeoutSeconds": 20
  },
  "Scanning": {
    "RetentionHours": 24,
    "MaxImageBytes": 6291456,
    "ManualReviewThreshold": 0.7
  },
  "EmergencyCard": {
    "PublicBaseUrl": "https://medguard.app",
    "TokenLifetimeDays": 365
  },
  "Caregivers": {
    "InvitationLifetimeHours": 72,
    "ExposeInvitationToken": false
  },
  "Demo": {
    "Enabled": true,
    "Email": "demo@medguard.app",
    "Password": "DemoPass123!"
  },
  "Email": {
    "ApiKey": "",
    "FromAddress": "MedGuard <onboarding@resend.dev>",
    "VerificationCodeLifetimeMinutes": 10
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
