# Copy to `.env` next to docker-compose.prod.yml and fill in real values. Never commit the real file.
POSTGRES_DB=medguard
POSTGRES_USER=medguard
POSTGRES_PASSWORD=change-me

# At least 32 characters.
JWT_SIGNING_KEY=change-me-to-a-long-random-string

# Base64 of exactly 32 random bytes: `openssl rand -base64 32`
FIELD_ENCRYPTION_KEY=change-me-base64-32-bytes

# Optional: real email delivery via Resend. Leave blank to only log emails.
RESEND_API_KEY=
EMAIL_FROM=MedGuard <onboarding@resend.dev>

# Public HTTPS base URL the API is reachable at (used for emergency-card links).
PUBLIC_BASE_URL=https://your-host.sslip.io

# Required for camera label reading. Without this the scanner can only parse typed OCR text.
OPENAI_API_KEY=
AI_VISION_ENABLED=true
AI_EXPLANATIONS_ENABLED=true